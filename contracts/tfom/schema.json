{
  "$defs": {
    "TfomProperty": {
      "additionalProperties": false,
      "description": "物模型属性（TFOM property）。",
      "properties": {
        "dtype": {
          "enum": [
            "float",
            "integer",
            "boolean",
            "string"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "max_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Value"
        },
        "min_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Value"
        },
        "name_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name En"
        },
        "name_zh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Zh"
        },
        "quantity_kind": {
          "anyOf": [
            {
              "enum": [
                "temperature",
                "temperature_difference",
                "power",
                "energy",
                "volume_flow",
                "mass_flow",
                "pressure",
                "percent",
                "dimensionless",
                "frequency",
                "time"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity Kind"
        },
        "role": {
          "enum": [
            "state",
            "control",
            "disturbance",
            "target",
            "context",
            "derived"
          ],
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "dtype",
        "role"
      ],
      "title": "TfomProperty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "TFOM 物模型定义（对应 contracts/tfom/schema.json）。",
  "properties": {
    "contract": {
      "const": "TFOM",
      "default": "TFOM",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "default": "1.0",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Contract Version",
      "type": "string"
    },
    "model_id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Model Id",
      "type": "string"
    },
    "properties": {
      "additionalProperties": {
        "$ref": "#/$defs/TfomProperty"
      },
      "title": "Properties",
      "type": "object"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "version",
    "properties"
  ],
  "title": "ObjectModel",
  "type": "object"
}
