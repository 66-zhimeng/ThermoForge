    {
      "name": "tf_preprocess_propose",
      "entry": "thermoforge_research.tools:tf_preprocess_propose",
      "side_effect": true,
      "returns_id": "ruleset_id@vN"
    },
    {
      "name": "tf_preprocess_approve",
      "entry": "thermoforge_research.tools:tf_preprocess_approve",
      "side_effect": true,
      "returns_id": "ruleset_id@vN",
      "actor_required": "human"
    },
    {
      "name": "tf_preprocess_apply",
      "entry": "thermoforge_research.tools:tf_preprocess_apply",
      "side_effect": true,
      "returns_id": "dataset_id@rev_NNNN"
    },
    {
      "name": "tf_preprocess_list",
      "entry": "thermoforge_research.tools:tf_preprocess_list",
      "side_effect": false
